        "type": "text"
      },
      {
        "key": "complainant_details",
        "label": "Complainant Name & Address",
        "type": "textarea",
        "placeholder": "e.g. Ravi Kumar, S/o Ramesh, 12 4th Cross, Indiranagar, Bengaluru"
      },
      {
        "key": "opposite_party_details",
        "label": "Opposite Party Name & Address",
        "type": "textarea"
      },
      {
        "key": "events",
        "label": "Facts in Date Order (one per line)",
        "type": "textarea",
        "placeholder": "12.01.2025 - Bought refrigerator for Rs. 45,000 (Invoice 1234)\n20.02.2025 - Cooling stopped; complaint No. 567 registered"
      },
      {
        "key": "jurisdiction_reason",
        "label": "Why This Commission Has Jurisdiction",
        "type": "text",
        "placeholder": "e.g. the complainant resides and the opposite party carries on business at Bengaluru"
      },
      {
        "key": "main_relief",
        "label": "Main Relief Sought",
        "type": "text",
        "placeholder": "e.g. refund Rs. 45,000 / replace the refrigerator"
      },
      {
        "key": "interest_rate",
        "label": "Interest Rate % (optional)",
        "type": "text"
      },
      {
        "key": "compensation_amount",
        "label": "Compensation Claimed (Rs.)",
        "type": "text"
      },
      {
        "key": "advocate_name",
        "label": "Advocate Name (optional)",
        "type": "text"
      },
      {
        "key": "place",
        "label": "Place",
        "type": "text"
      },
      {
        "key": "date",
        "label": "Date",
        "type": "text"
      }
    ]
  },
