[
  {
    "id": "consumer_legal_notice",
    "name": "1. Consumer Legal Notice",
    "aliases": [
      "consumer",
      "consumer court",
      "consumer commission",
      "consumer forum",
      "district commission",
      "legal notice",
      "notice",
      "pre-complaint notice",
      "deficiency",
      "defect",
      "refund"
    ],
    "description": "Notice to a seller/service provider for defect or deficiency in service, before filing a consumer complaint.",
    "docx_template": "consumer_legal_notice.docx",
    "fields": [
      {
        "key": "client_name",
        "label": "Your Name (the consumer)",
        "type": "text"
      },
      {
        "key": "client_address",
        "label": "Your Address",
        "type": "textarea"
      },
      {
        "key": "opposite_party_name",
        "label": "Opposite Party Name",
        "type": "text",
        "placeholder": "e.g. XYZ Electronics Pvt. Ltd."
      },
      {
        "key": "opposite_party_address",
        "label": "Opposite Party Address",
        "type": "textarea"
      },
      {
        "key": "grievance_type",
        "label": "Nature of Grievance",
        "type": "text",
        "placeholder": "e.g. defect in goods / deficiency in service"
      },
      {
        "key": "product_or_service",
        "label": "Product or Service",
        "type": "text",
        "placeholder": "e.g. LG washing machine model FHM1207"
      },
      {
        "key": "invoice_no",
        "label": "Invoice / Receipt No.",
        "type": "text"
      },
      {
        "key": "purchase_date",
        "label": "Date of Purchase",
        "type": "text"
      },
      {
        "key": "amount_paid",
        "label": "Amount Paid (Rs.)",
        "type": "text"
      },
      {
        "key": "defect_details",
        "label": "What Went Wrong",
        "type": "textarea",
        "narrative": true,
        "placeholder": "Describe the defect or poor service"
      },
      {
        "key": "first_complaint_date",
        "label": "Date You First Complained",
        "type": "text"
      },
      {
        "key": "opposite_party_response",
        "label": "Their Response (leave blank if none)",
        "type": "textarea"
      },
      {
        "key": "demand",
        "label": "What You Demand",
        "type": "text",
        "placeholder": "e.g. refund Rs. 32,000 / replace the product"
      },
      {
        "key": "interest_rate",
        "label": "Interest Rate % (optional)",
        "type": "text",
        "placeholder": "e.g. 12"
      },
      {
        "key": "notice_period",
        "label": "Days Given to Comply",
        "type": "text",
        "placeholder": "15 (fifteen)"
      },
      {
        "key": "advocate_name",
        "label": "Advocate Name (optional)",
        "type": "text"
      },
      {
        "key": "notice_date",
        "label": "Notice Date",
        "type": "text"
      }
    ]
  },
  {
    "id": "consumer_complaint",
