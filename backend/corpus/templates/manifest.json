    "fields": [
      {
        "key": "district",
        "label": "District",
        "type": "text",
        "placeholder": "e.g. BENGALURU URBAN"
      },
      {
        "key": "complainant_name",
        "label": "Your Name",
        "type": "text"
      },
      {
        "key": "complainant_address",
        "label": "Your Address",
        "type": "textarea"
      },
      {
        "key": "opposite_party_name",
        "label": "Seller / Company Name",
        "type": "text"
      },
      {
        "key": "opposite_party_address",
        "label": "Seller / Company Address",
        "type": "textarea"
      },
      {
        "key": "product_or_service",
        "label": "Product or Service",
        "type": "text",
        "placeholder": "e.g. a Samsung refrigerator, model ___"
      },
      {
        "key": "purchase_date",
        "label": "Date of Purchase",
        "type": "text"
      },
      {
        "key": "amount_paid",
        "label": "Amount Paid (Rs.)",
        "type": "text"
      },
      {
        "key": "complaint_facts",
        "label": "What Went Wrong",
        "type": "textarea",
        "narrative": true,
        "placeholder": "Describe the defect or poor service and what the seller said when you complained"
      },
      {
        "key": "relief_sought",
        "label": "Relief You Want",
        "type": "textarea",
        "placeholder": "e.g. Refund of Rs. 45,000 with interest, Rs. 20,000 compensation for harassment"
      },
      {
        "key": "place",
        "label": "Place",
        "type": "text"
      },
      {
        "key": "date",
        "label": "Date",
        "type": "text"
      }
