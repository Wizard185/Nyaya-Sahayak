# --- Ollama (local LLM & Embeddings) ---

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_EMBED_MODEL=all-minilm:latest
OLLAMA_NUM_PREDICT=600
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT=180

# --- Per-step pipeline timeouts (seconds) ---

RETRIEVAL_TIMEOUT_SECONDS=60
GENERATION_TIMEOUT_SECONDS=200
TRANSLATION_TIMEOUT_SECONDS=30
DRAFT_POLISH_TIMEOUT_SECONDS=120
DRAFT_POLISH_ENABLED=true

# --- Pinecone (vector DB) ---

# Create a free account at https://www.pinecone.io, create an API key, paste it below.

PINECONE_API_KEY=
PINECONE_INDEX_NAME=nyaya-sahayak-statutes-allminilm
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
ENVIRONMENT=development

# if ENVIRONMENT is production , embeddings are generated through HuggingFace Cloud

HF_API_KEY=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- MongoDB (local, app data: users/chats/messages/drafts) ---

MONGO_URL=
MONGO_DB_NAME=nyaya_sahayak

# --- Auth ---

# Generate a real random value for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=dev-only-change-this-secret-in-.env

# --- Admin/dev-only ingestion routes (never linked from the frontend) ---

ADMIN_API_KEY=

# --- Document drafting output ---

DRAFT_OUTPUT_PATH=./drafts_storage

# --- CORS ---

CORS_ORIGINS=http://localhost:5173
